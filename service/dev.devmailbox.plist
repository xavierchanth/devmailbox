<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent. Install:
       just compile && install -m755 dist/devmailbox ~/.local/bin/devmailbox
       edit the path below (launchd doesn't expand ~), then
       cp service/dev.devmailbox.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.devmailbox.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.devmailbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/devmailbox</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/devmailbox.log</string>
  <key>StandardOutPath</key>
  <string>/tmp/devmailbox.log</string>
</dict>
</plist>
