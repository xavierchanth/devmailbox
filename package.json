{
  "name": "devmailbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained dev mailbox: a Resend-compatible API and an SMTP sink, read through a dashboard, an HTTP API and MCP.",
  "bin": {
    "devmailbox": "./server/main.ts"
  },
  "scripts": {
    "start": "bun server/main.ts serve",
    "dev": "bun --watch server/main.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.18",
    "postal-mime": "4.2.1",
    "smtp-server": "3.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "nodemailer": "10.5.0",
    "resend": "6.38.0",
    "typescript": "7.0.2"
  }
}
